---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<button type="button" class="aac-hdr-btn" data-aac-export title="진도 내보내기 (JSON)" aria-label="진도 내보내기">
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" />
  </svg>
</button>
<button type="button" class="aac-hdr-btn" data-aac-import-btn title="진도 불러오기 (JSON)" aria-label="진도 불러오기">
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 15V3" /><path d="m7 8 5-5 5 5" /><path d="M5 21h14" />
  </svg>
</button>
<input type="file" accept="application/json,.json" data-aac-import hidden />
<Default />

<script>
  import { exportProgress, importProgress, toast } from '../scripts/backup';

  document.querySelectorAll<HTMLButtonElement>('[data-aac-export]').forEach((btn) =>
    btn.addEventListener('click', () => {
      toast(exportProgress() ? '진도를 JSON 파일로 내보냈습니다.' : '이 브라우저에서는 저장소에 접근할 수 없습니다.');
    }),
  );

  document.querySelectorAll<HTMLButtonElement>('[data-aac-import-btn]').forEach((btn) =>
    btn.addEventListener('click', () => (btn.nextElementSibling as HTMLInputElement | null)?.click()),
  );

  document.querySelectorAll<HTMLInputElement>('[data-aac-import]').forEach((input) =>
    input.addEventListener('change', async () => {
      const file = input.files?.[0];
      input.value = '';
      if (!file) return;
      try {
        const n = await importProgress(file);
        toast(`${n}개 항목을 불러왔습니다. 새로고침합니다…`);
        setTimeout(() => location.reload(), 900);
      } catch {
        toast('올바른 진도 JSON 파일이 아닙니다.');
      }
    }),
  );
</script>

<style>
  .aac-hdr-btn {
    display: inline-flex;
    align-items: center;
    background: none;
    border: 0;
    padding: 0.5em;
    margin: -0.5em;
    color: var(--sl-color-text-accent);
    cursor: pointer;
    font: inherit;
  }
  .aac-hdr-btn:hover {
    color: var(--sl-color-white);
  }
  .aac-hdr-btn:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
